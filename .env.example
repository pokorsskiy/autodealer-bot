# ===================================================
# Шаблон конфигурации окружения Telegram Бота
# Скопируйте этот файл в .env для локальной разработки
# ===================================================

# Токен вашего бота от @BotFather (обязательно)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ

# Ваш личный Telegram ID для получения уведомлений и прав админа (обязательно)
YOUR_CHAT_ID=123456789

# Путь к файлу базы данных SQLite (по умолчанию instagram_users.db)
# На хостинге (например Railway Volume) используйте: /data/instagram_users.db
DB_NAME=instagram_users.db
